rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function ownsProfile(profileId) {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/profiles/$(profileId)).data.parent_user_id == request.auth.uid;
    }

    match /book_pages/{profileId}/{fileName} {
      allow read, write: if ownsProfile(profileId);
    }
  }
}
