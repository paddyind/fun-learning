# Keycloak OIDC Configuration
# Keycloak is NOT part of this repo — it's owned by the sibling
# identity-platform project. Start it first: `cd ../identity-platform &&
# docker compose up -d`. Its realm for this app is already defined there
# (realms/fun-learning-realm.json) — use these values as-is for local
# testing:
#   KEYCLOAK_CLIENT_ID=fun-learning-app
#   KEYCLOAK_CLIENT_SECRET=fun-learning-app-dev-secret-change-in-production
#   KEYCLOAK_ISSUER=http://localhost:3510/realms/fun-learning
# Test user: parent1@example.com / parent12345. For a real deployment,
# replace all three with your organization's actual Keycloak realm/client
# values (see docs/setup-guide.md §3 and identity-platform's
# docs/ONBOARDING.md § Production cutover).
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=
# Only needed when this app runs inside Docker — lets its own server reach
# the same Keycloak via a different hostname than the browser uses. Leave
# unset for `npm run dev` (falls back to KEYCLOAK_ISSUER automatically);
# docker-compose.yml sets it for the containerized run.
KEYCLOAK_INTERNAL_ISSUER=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Firebase Credentials (client, public by design)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firestore + Storage are emulated locally by default (see
# Dockerfile.emulator) so real Firebase Storage's Blaze-plan requirement
# doesn't block local testing. Auth stays real either way.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# AI Key
GEMINI_API_KEY=
# Optional — defaults to gemini-2.5-flash if unset
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin (service account) — required for the Keycloak -> Firebase
# custom-token bridge. Generate via Firebase Console > Project Settings >
# Service Accounts > Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
