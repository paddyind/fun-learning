# Keycloak OIDC Configuration
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Firebase Credentials (client, public by design)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firestore + Storage are emulated locally by default (see
# Dockerfile.emulator) so real Firebase Storage's Blaze-plan requirement
# doesn't block local testing. Auth stays real either way.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# AI Key
GEMINI_API_KEY=
# Optional — defaults to gemini-2.5-flash if unset
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin (service account) — required for the Keycloak -> Firebase
# custom-token bridge. Generate via Firebase Console > Project Settings >
# Service Accounts > Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
